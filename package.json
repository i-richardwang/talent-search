{
  "name": "talent-search",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3100",
    "ui": "bun --bun vite --config scripts/design-system/vite.config.ts",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "db:push": "bun --env-file=.env.local --bun drizzle-kit push",
    "db:studio": "bun --env-file=.env.local --bun drizzle-kit studio",
    "format": "biome check --write",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=.env.local scripts/test.ts",
    "sync": "bun --env-file=.env.local scripts/sync.ts",
    "derive": "bun --env-file=.env.local scripts/derive.ts",
    "query": "bun scripts/query.ts",
    "eval": "bun scripts/eval.ts",
    "eval:extract": "bun scripts/eval-extract.ts",
    "eval:review": "bun scripts/eval-review.ts",
    "eval:understand": "bun scripts/eval-understand.ts",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.41",
    "@base-ui/react": "1.8.0",
    "@lobehub/webfont-harmony-sans-sc-mini": "1.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "ai": "7.0.85",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "drizzle-orm": "0.45.2",
    "hyparquet": "1.30.0",
    "hyparquet-compressors": "1.1.1",
    "lucide-react": "1.38.0",
    "motion": "12.43.0",
    "pg": "8.22.0",
    "pg-boss": "12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.10",
    "react-colorful": "5.6.1",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
