# 数据库。必需。默认值就是 README 里那条 docker 命令起的库，照抄可以直接跑。
DATABASE_URL=postgresql://talent:talent@localhost:55434/talent

# 登录。用 openssl rand -base64 32 生成独立密钥，不使用示例或共享默认值。
# 生产地址必须使用 HTTPS，只写来源地址，不带路径；反向代理保持这个来源。
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# 嵌入端点（可选）。OpenAI 兼容的 /embeddings；只有词表整理用它，把写法相近的词分成组交给判定方。
# 不配时整理不收集新的组，同步、解析和检索不受影响。
# 送过去的是简历里读出的能力词和入职前岗位名，没有姓名、工号和描述原文。
# EMBED_BASE_URL=http://embed.internal.example/v1
# EMBED_MODEL=BAAI/bge-m3
# 向量缓存的空间身份。模型、权重、归一化或端点实现变化时必须换一个值，旧向量不再被读到。
# 维数不在这里：它是 src/db/schema.ts 里的 EMBED_DIM，全库只有那一处。
# EMBED_SPACE_ID=bge-m3-v1
# EMBED_API_KEY=
# 一次尝试的超时（毫秒）。
# EMBED_TIMEOUT_MS=30000

# 聊天端点（抽取与模型整理可选）。OpenAI 兼容的 /chat/completions；派生用它把入职前经历的简历描述读成能力词和投入档，
# 把入职前岗位对到公司序列；整理可以用同一地址判能力词的写法和归属。
# 岗位名、公司名和描述原文会送到这里：用公网服务就是把经历交给第三方，由部署方按数据政策决定。
# EXTRACT_BASE_URL=http://llm.internal.example/v1
# EXTRACT_MODEL=
# EXTRACT_API_KEY=
# 序列对齐用的模型，不设就用 EXTRACT_MODEL。
# ALIGN_MODEL=
# 对齐可单独指定端点；未设地址时沿用抽取的地址和密钥。
# 设了地址则只使用 ALIGN_API_KEY，不把抽取密钥发到另一家服务。
# ALIGN_BASE_URL=https://another-llm.example/v1
# ALIGN_API_KEY=
# 整理归并用的模型（同一个端点），不设就用 EXTRACT_MODEL。总量只有几百组，
# 但要划清相近词，值得单独给一个更强的模型。
# REVIEW_MODEL=

# 整理的判定交给谁。model＝上面那个模型，分组、判定、生效在一轮任务里做完；
# external＝只分组和让判定生效，待判的组留在队列里等外部 agent 提交判定；off＝不运行整理。
# 不设时，有 EXTRACT_BASE_URL 与 REVIEW_MODEL/EXTRACT_MODEL 就用 model，否则用 off。
# 显式设 model 却没有完整模型配置、或写了其他值，会直接报错。
# REVIEW_JUDGE=model
# 外部判定接口（GET/POST /api/review）的凭据。接口只在 REVIEW_JUDGE=external 且配了它时开着，
# 其余情况回 404，等于不存在。
# 发出去的只有能力词和人数，没有姓名、工号，也没有简历原文。
# REVIEW_TOKEN=
# 思考开关按模型需要设置；不设就不发这个字段，由端点决定。
# EXTRACT_ENABLE_THINKING=false
# 端点不支持 response_format: json_schema 时设为 false
# EXTRACT_STRUCTURED_OUTPUTS=false
# 一次调用的总时限（毫秒，含思考、正文读取与重试）和并发数，默认 180000 / 4。
# 总时限耗尽后中止本机请求，不再重试。
# 不发送输出 token 上限；实际输出仍受模型服务自身的限制。
# EXTRACT_TIMEOUT_MS=180000
# EXTRACT_CONCURRENCY=4

# 默认 csv-dir：读一个目录里的 CSV（有哪些文件见 README「接入数据源」），不配 TALENT_CSV_DIR 时读仓库自带的合成样例。
# 私有适配器填写模块的绝对路径；它在运行时加载，不进入服务端构建产物。
TALENT_SOURCE=csv-dir
# TALENT_SOURCE=/absolute/path/to/src/corpus/sources/company.ts
# TALENT_CSV_DIR=/absolute/path/to/csv-dir

# 查询理解。AI 搜索靠它把一句话读成条件、读搜到的候选人的经历并判断谁符合；
# 缺 LLM_BASE_URL 或 LLM_MODEL 时只有关键词搜索。
# 发过去的有用户敲的那句话、当前条件、数据目录的概况、工具查到的人数和人才库里的写法
# （说法、公司、部门、学校），以及候选人被搜到的那几段经历（公司或部门、序列、岗位、技能、简历原文）；
# 端点要部署在这些数据可以去的范围内。端点须支持工具调用。一轮要读上百段经历，用不带思考的快模型。
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# 带思考的模型设为 false：思考会让一轮从二十秒变成一两分钟，还会先用完输出预算；不设就不发这个字段
# LLM_ENABLE_THINKING=false
# 端点属性：一次尝试的超时（毫秒）与输出预算。默认 60000 / 16000。
# LLM_TIMEOUT_MS=60000
# LLM_MAX_OUTPUT_TOKENS=16000
