# 数据库。必需。默认值就是 README 里那条 docker 命令起的库，照抄可以直接跑。
# 库里必须装好 pgvector（`create extension vector`）。
DATABASE_URL=postgresql://talent:talent@localhost:55434/talent

# 嵌入端点。必需——检索按语义相似度匹配，没有向量就没有检索。
# OpenAI 兼容的 /embeddings；ETL 与查询侧必须属于同一个嵌入空间，运行时会核验身份与 canary。
# ETL 会把每个人的经历原文送到这里：用公网服务就是把经历交给第三方，由部署方按数据政策决定。
EMBED_BASE_URL=http://embed.internal.example/v1
EMBED_MODEL=BAAI/bge-m3
# 嵌入空间的稳定身份。模型、权重、归一化或端点实现变化时必须换一个值并重跑 ETL。
EMBED_SPACE_ID=bge-m3-v1
# 向量维数。只有 ETL 读它，默认 1024，和 src/db/schema.ts 里那个常量同值，
# 所以一般不用填；两边改成别的值时必须一起改。
# EMBED_DIM=1024
# EMBED_API_KEY=
# 重排模型。必需——向量只负责召回候选，命中由重排判定（见 src/search/weights.ts）。
# Cohere 式的 /rerank；端点与密钥默认沿用 EMBED_BASE_URL / EMBED_API_KEY。
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 重排空间变化时换一个值；缓存按它隔离，不按可能复用的模型名隔离。
RERANK_SPACE_ID=bge-reranker-v2-m3-v1
# RERANK_BASE_URL=
# RERANK_API_KEY=
# ETL 单次请求的超时（秒）。CPU 上一批 32 段通常几秒。
# EMBED_TIMEOUT_S=120
# 查询侧嵌入与重排请求超时（毫秒），重排并发数默认 4。
# EMBED_TIMEOUT_MS=30000
# RERANK_TIMEOUT_MS=30000
# RERANK_CONCURRENCY=4
# ETL 的向量缓存（SQLite）。默认 .cache/embeddings.sqlite；重置库、重跑 ETL 都不必再打端点。
# EMBED_CACHE_PATH=

# 抽取（可选）。OpenAI 兼容的 /chat/completions；ETL 用它把入职前经历的简历描述读成能力词和做过的事，
# 把入职前岗位对到公司序列，并整理能力词的不同写法。地址和模型名缺一个就都不做，ETL 会打印跳过，检索照常可用。
# 岗位名、公司名和描述原文会送到这里：数据边界和嵌入端点一样。
# EXTRACT_BASE_URL=http://llm.internal.example/v1
# EXTRACT_MODEL=
# EXTRACT_API_KEY=
# 带思考的模型（Qwen3 等）设为 false：思考会先把输出预算烧光、返回空内容。不设就不发这个字段。
# EXTRACT_ENABLE_THINKING=false
# 端点不支持 response_format: json_schema 时设为 false
# EXTRACT_STRUCTURED_OUTPUTS=false
# 端点属性：单次超时（秒）、并发数、输出预算（思考轨迹也算）。默认 120 / 4 / 4000。
# EXTRACT_TIMEOUT_S=120
# EXTRACT_CONCURRENCY=4
# EXTRACT_MAX_OUTPUT_TOKENS=4000
# 抽取结果的本地缓存（SQLite），默认 .cache/extractions.sqlite
# EXTRACT_CACHE_PATH=

# 数据源适配器，对应 etl/sources/<name>.py。
# 默认 csv_dir：读一个目录里的三个 CSV，不配 TALENT_CSV_DIR 时读仓库自带的合成样例。
TALENT_SOURCE=csv_dir
# TALENT_CSV_DIR=/absolute/path/to/csv-dir

# 查询理解。一句话只有模型能读成条件，缺 LLM_BASE_URL 或 LLM_MODEL 时整句搜索直接报错；
# 只发用户敲的那句话和几维筛选的取值，不发经历原文，所以可以走公网端点。
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# 端点不支持 response_format: json_schema 时设为 false
# LLM_STRUCTURED_OUTPUTS=false
# 端点属性：对面那个模型有多慢、多啰嗦。默认 60000 / 8000。
# LLM_TIMEOUT_MS=60000
# LLM_MAX_OUTPUT_TOKENS=8000
