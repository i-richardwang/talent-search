# 数据库。必需。默认值就是 README 里那条 docker 命令起的库，照抄可以直接跑。
# 库里必须装好 pgvector（`create extension vector`）。
DATABASE_URL=postgresql://talent:talent@localhost:55434/talent

# 嵌入端点。必需——检索按语义相似度匹配，没有向量就没有检索。
# OpenAI 兼容的 /embeddings；派生和查询走同一个模块、同一份配置，所以天然属于同一个嵌入空间。
# 派生会把每个人的经历原文送到这里：用公网服务就是把经历交给第三方，由部署方按数据政策决定。
EMBED_BASE_URL=http://embed.internal.example/v1
EMBED_MODEL=BAAI/bge-m3
# 嵌入空间的稳定身份。模型、权重、归一化或端点实现变化时必须换一个值，派生会把说法整张重算。
# 维数不在这里：它是 src/db/schema.ts 里的 EMBED_DIM，全库只有那一处。
EMBED_SPACE_ID=bge-m3-v1
# EMBED_API_KEY=
# 重排模型。必需——向量只负责召回候选，命中由重排判定（见 src/search/weights.ts）。
# Cohere 式的 /rerank；端点与密钥默认沿用 EMBED_BASE_URL / EMBED_API_KEY。
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 重排空间变化时换一个值；缓存按它隔离，不按可能复用的模型名隔离。
RERANK_SPACE_ID=bge-reranker-v2-m3-v1
# RERANK_BASE_URL=
# RERANK_API_KEY=
# 端点属性：一次尝试的超时（毫秒）与重排并发数。
# EMBED_TIMEOUT_MS=30000
# RERANK_TIMEOUT_MS=30000
# RERANK_CONCURRENCY=4

# 聊天端点（抽取与模型整理可选）。OpenAI 兼容的 /chat/completions；派生用它把入职前经历的简历描述读成能力词和做过的事，
# 把入职前岗位对到公司序列；整理可以用同一地址判能力词的写法、归属并写释义。
# 岗位名、公司名和描述原文会送到这里：数据边界和嵌入端点一样。
# EXTRACT_BASE_URL=http://llm.internal.example/v1
# EXTRACT_MODEL=
# EXTRACT_API_KEY=
# 整理归并与释义用的模型（同一个端点），不设就用 EXTRACT_MODEL。总量只有几百组，
# 但要划清相近词并写准确释义，值得单独给一个更强的模型。
# REVIEW_MODEL=

# 整理的判卷交给谁。model＝上面那个模型，出题答题结算一轮里做完；
# external＝只出题和结算，题挂在队列上等外部 agent 交卷；off＝整理不跑。
# 不设时，有 EXTRACT_BASE_URL 与 REVIEW_MODEL/EXTRACT_MODEL 就用 model，否则用 off。
# 显式设 model 却没有完整模型配置、或写了其他值，会直接报错。
# REVIEW_JUDGE=model
# 外部判卷接口（GET/POST /api/review）的凭据。接口只在 REVIEW_JUDGE=external 且配了它时开着，
# 其余情况回 404，等于不存在。
# 出去的只有能力词和人数，没有姓名、工号，也没有简历原文。
# REVIEW_TOKEN=
# 带思考的模型（Qwen3 等）设为 false：思考会先把输出预算烧光、返回空内容。不设就不发这个字段。
# EXTRACT_ENABLE_THINKING=false
# 端点不支持 response_format: json_schema 时设为 false
# EXTRACT_STRUCTURED_OUTPUTS=false
# 端点属性：一次尝试的超时（毫秒）、并发数、输出预算（思考轨迹也算）。默认 120000 / 4 / 16000。
# EXTRACT_TIMEOUT_MS=120000
# EXTRACT_CONCURRENCY=4
# EXTRACT_MAX_OUTPUT_TOKENS=16000

# 数据源适配器，对应 src/corpus/sources/<name>.ts。
# 默认 csv-dir：读一个目录里的三个 CSV，不配 TALENT_CSV_DIR 时读仓库自带的合成样例。
TALENT_SOURCE=csv-dir
# TALENT_CSV_DIR=/absolute/path/to/csv-dir

# 查询理解。一句话只有模型能读成条件，缺 LLM_BASE_URL 或 LLM_MODEL 时整句搜索直接报错；
# 只发用户敲的那句话和几维筛选的取值，不发经历原文，所以可以走公网端点。
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# 端点不支持 response_format: json_schema 时设为 false
# LLM_STRUCTURED_OUTPUTS=false
# 带思考的模型设为 false，否则思考会先烧光输出预算；不设就不发这个字段
# LLM_ENABLE_THINKING=false
# 端点属性：对面那个模型有多慢、多啰嗦。默认 60000 / 16000。
# LLM_TIMEOUT_MS=60000
# LLM_MAX_OUTPUT_TOKENS=16000
