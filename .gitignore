node_modules/
.recovered/
dist/
.output/
.nitro/
.tanstack/
.env
.env.local
# 员工数据一律不进版本库
data/
*.parquet
*.xlsx
*.csv

# 数据源适配器默认是私有的：字段名、字典码、组织口径本身就是内部信息。
# 白名单式规则——新写一个适配器天然不进仓库，「忘了加 ignore」不可能发生。
src/corpus/sources/*
!src/corpus/sources/csv-dir.ts
!src/corpus/sources/sample/
!src/corpus/sources/sample/*.csv
!src/corpus/sources/sample/README.md

# 验收集：检索真题指向真人，抽取真题是真人的简历原文，整理真题是从库里圈出来的词，都不进版本库。
# 每把尺子的 sample.json 例外——合成的，干净克隆也能跑通的基线。
evals/*/*
!evals/*/sample.json

# 个人工具配置，不是产品依赖
.mcp.json
